<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<ItemDefinitionGroup>
		<ClCompile>
			<AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
			<PreprocessorDefinitions>MARIADB_STATIC_LINK;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
		<ResourceCompile>
			<AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
			<PreprocessorDefinitions>MARIADB_STATIC_LINK;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ResourceCompile>
	</ItemDefinitionGroup>
	<ItemGroup Condition="$(ConfigurationType)=='StaticLibrary'">
		<PropertyPageSchema Include="$(MSBuildThisFileDirectory)\链接设置.xml" />
	</ItemGroup>
	<ItemDefinitionGroup Condition="$(埃博拉酱_MariaDB_链接方式)=='符号' Or $(ConfigurationType)!='StaticLibrary'">
		<Link>
			<AdditionalDependencies>Shlwapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
		</Link>
	</ItemDefinitionGroup>
	<ItemGroup Condition="$(埃博拉酱_MariaDB_链接方式)=='内联'">
		<Library Include="Shlwapi.lib" />
	</ItemGroup>
	<Target Name="埃博拉酱_MariaDB_符号链接" BeforeTargets="Link" Condition="$(埃博拉酱_MariaDB_链接方式)=='符号' Or $(ConfigurationType)!='StaticLibrary'">
		<PropertyGroup>
			<!--ItemGroup不能直接捕获ClCompile的属性，因此需要在这里传递-->
			<RuntimeLibrary>%(ClCompile.RuntimeLibrary)</RuntimeLibrary>
		</PropertyGroup>
		<ItemGroup>
			<Link Update="@(Link)">
				<AdditionalDependencies>$(MSBuildThisFileDirectory)MariaDB_Connector.$(RuntimeLibrary).$(PlatformToolsetVersion).lib;%(AdditionalDependencies)</AdditionalDependencies>
			</Link>
		</ItemGroup>
	</Target>
	<Target Name="埃博拉酱_MariaDB_内联链接" BeforeTargets="ClCompile" Condition="$(埃博拉酱_MariaDB_链接方式)=='内联'">
		<PropertyGroup>
			<!--ItemGroup不能直接捕获ClCompile的属性，因此需要在这里传递-->
			<RuntimeLibrary>%(ClCompile.RuntimeLibrary)</RuntimeLibrary>
		</PropertyGroup>
		<ItemGroup>
			<Library Include="$(MSBuildThisFileDirectory)MariaDB_Connector.$(RuntimeLibrary).$(PlatformToolsetVersion).lib" />
		</ItemGroup>
	</Target>
</Project>